# Server Configuration
PORT=5000

# Database Configuration
# For local MongoDB: YOUR_MONGODB_CONNECTION_URI
# For MongoDB Atlas: YOUR_MONGODB_CONNECTION_URI
MONGODB_URI=YOUR_MONGODB_CONNECTION_URI

# JWT Configuration
# Generate a strong, random secret key for production
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_JWT_SECRET
JWT_EXPIRE=7d

# Admin Configuration
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_ADMIN_PASSWORD

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes

# Environment
NODE_ENV=development

# Additional Security Headers
CORS_ORIGIN=http://localhost:3000

# Session Configuration (if needed)
SESSION_SECRET=REPLACE_WITH_A_SEPARATE_LONG_RANDOM_SESSION_SECRET

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # 100 requests per window

# Logging
LOG_LEVEL=info

# Database Options
DB_CONNECTION_TIMEOUT=30000
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2